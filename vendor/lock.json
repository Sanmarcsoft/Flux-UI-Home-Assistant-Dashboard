{
  "schema": 1,
  "patches": {
    "bubble-no-module-store": {
      "id": "bubble-no-module-store",
      "find": "fetch(`https://api.github.com/repos/Clooos/Bubble-Card/discussions",
      "replace": "((..._a)=>Promise.reject(new Error(\"Bubble Card module store disabled by Sanmarcsoft hardening\")))(`https://api.github.com/repos/Clooos/Bubble-Card/discussions",
      "count": 1
    },
    "bubble-no-google-translate": {
      "id": "bubble-no-google-translate",
      "find": "fetch(`https://translate.googleapis.com/translate_a/single?${n}`)",
      "replace": "Promise.reject(new Error(\"Google Translate disabled by Sanmarcsoft hardening\"))",
      "count": 1
    },
    "bubble-local-translations": {
      "id": "bubble-local-translations",
      "find": "e.push(\"/hacsfiles/Bubble-Card/\")",
      "replace": "e.push(\"/local/vendor/bubble-card/\")",
      "count": 1
    },
    "bubble-no-remote-gif": {
      "id": "bubble-no-remote-gif",
      "find": " src=\"https://raw.githubusercontent.com/Clooos/Bubble-Card/main/.github/bubble-card.gif\"",
      "replace": " alt=\"Bubble Card\"",
      "count": 1
    },
    "bubble-no-badge-images": {
      "id": "bubble-no-badge-images",
      "find": "<img src=\"https://img.shields.io/",
      "replace": "<img data-blocked-src=\"https://img.shields.io/",
      "count": 3
    },
    "bubble-no-avatar-image": {
      "id": "bubble-no-avatar-image",
      "find": "<img src=\"https://avatars.githubusercontent.com/",
      "replace": "<img data-blocked-src=\"https://avatars.githubusercontent.com/",
      "count": 1
    },
    "ccf-no-eval-action": {
      "id": "ccf-no-eval-action",
      "find": "eval(action){eval(action.eval??\"\")}",
      "replace": "eval(action){console.warn(\"custom-card-features: eval action disabled by Sanmarcsoft hardening\")}",
      "count": 1
    },
    "same-origin-fetch-prelude": {
      "id": "same-origin-fetch-prelude",
      "prepend": "var __smsSameOriginFetch=(u,o)=>{const x=new URL(String(u instanceof Request?u.url:u),location.href);return x.origin===location.origin?fetch(u,o):Promise.reject(new Error(\"cross-origin fetch blocked by Sanmarcsoft hardening: \"+x.origin))};\n"
    },
    "streamline-same-origin": {
      "id": "streamline-same-origin",
      "find": "await fetch(",
      "replace": "await __smsSameOriginFetch(",
      "count": 3
    },
    "myu-same-origin": {
      "id": "myu-same-origin",
      "find": "r=await fetch(i,{mode:\"cors\"})",
      "replace": "r=await __smsSameOriginFetch(i,{mode:\"cors\"})",
      "count": 1
    },
    "fgm-local-backgrounds": {
      "id": "fgm-local-backgrounds",
      "find": "https://cdn.jsdelivr.net/gh/wessamlauf/homeassistant-frosted-glass-themes@refs/heads/main/themes/",
      "replace": "/local/vendor/frosted-glass/",
      "count": 2
    }
